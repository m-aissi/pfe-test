# Copier ce fichier en backend/.env et le compléter. backend/.env n'est jamais commité.

# Adresse publique du site, sans / final (en développement : http://localhost:4200). Sert aux retours de connexion Google/Discord
# et active les cookies "Secure" quand elle commence par https.
PUBLIC_URL=https://yugioh.miroirdesreves.com

# Clé qui signe les sessions. Longue et aléatoire : openssl rand -hex 32
# La changer déconnecte tout le monde.
SESSION_SECRET=

# Connexion avec Google (https://console.cloud.google.com/apis/credentials, "ID client OAuth", type "Application Web")
# URI de redirection à autoriser : <PUBLIC_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Connexion avec Discord (https://discord.com/developers/applications, onglet OAuth2)
# Redirect à autoriser : <PUBLIC_URL>/api/auth/oauth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Facultatif. En prod, PORT, HOST et MONGO_URI sont fixés par ecosystem.config.js ;
# sans eux (développement) : port 4441, base yugioh_dev.
# PORT=4441
# MONGO_URI=mongodb://127.0.0.1:27017/yugioh_dev
# IMAGE_CACHE_DIR=/chemin/vers/le/cache/des/images   (par défaut : data/images à la racine du projet)
# CARDS_SYNC=on   (off : jamais de synchro ygoprodeck ; force : resynchronise aussi au démarrage)
